# Configuração do Bot do Telegram
# Obtenha o token criando um bot com o @BotFather no Telegram
TELEGRAM_BOT_TOKEN="seu_token_aqui"

# Obtenha o chat_id falando com o bot e consultando a API do Telegram (ou use o @userinfobot)
TELEGRAM_CHAT_ID="seu_chat_id_aqui"

# Configurações opcionais de ambiente
PORTA=8000
PASTA_SAIDA=dados
ESTADO_FILE=dados/ultimo_capitulo.json
TELEGRAM_ENVIOS_LOG=dados/envios_telegram.log
